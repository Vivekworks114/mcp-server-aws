# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-change-in-production-use-long-random-string

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# DynamoDB Table Names (optional, defaults provided)
COMPANIES_TABLE=companies
USERS_TABLE=users
AGENTS_TABLE=agents
AUDIT_LOGS_TABLE=audit_logs

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Vector Database Configuration (Pinecone)
VECTOR_DB_TYPE=pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=mcp-server

# Embeddings Configuration
# IMPORTANT: The embeddings model dimension MUST match your Pinecone index dimension
# 
# Option 1: HuggingFace Embeddings (Free, no API key required)
# EMBEDDINGS_PROVIDER=huggingface
# EMBEDDINGS_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2  # 384 dimensions
# 
# Option 2: OpenAI Embeddings (Requires API key, produces 1536 dimensions)
# EMBEDDINGS_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key-here
# EMBEDDINGS_MODEL_NAME=text-embedding-ada-002  # 1536 dimensions (default)
# 
# Common HuggingFace models:
# - sentence-transformers/all-MiniLM-L6-v2 (384 dimensions)
# - sentence-transformers/all-mpnet-base-v2 (768 dimensions)
# - sentence-transformers/paraphrase-multilingual-mpnet-base-v2 (768 dimensions)
# 
# OpenAI models:
# - text-embedding-ada-002 (1536 dimensions) - default
# - text-embedding-3-small (1536 dimensions)
# - text-embedding-3-large (3072 dimensions)
EMBEDDINGS_PROVIDER=huggingface
EMBEDDINGS_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
OPENAI_API_KEY=

# API Keys (for development/testing - use AWS Secrets Manager in production)
# These are used when deploying agents locally or for testing
GROQ_API_KEY=your-groq-api-key-here
HF_API_KEY=your-huggingface-token-here

# AgentCore Configuration
AGENTCORE_IAM_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/YOUR_AGENTCORE_ROLE_NAME
AGENTCORE_FOUNDATION_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
