# Agent Environment Variables
# These are set automatically during agent deployment
# For local testing/development, you can set these manually

# Company Configuration (set during deployment)
COMPANY_ID=your-company-id
COMPANY_NAME=Your Company Name
MEMORY_ID=company_your-company-id_memory-xxxxx
VECTOR_DB_NAMESPACE=company_your-company-id

# API Keys (retrieved from AWS Secrets Manager in production)
GROQ_API_KEY=your-groq-api-key
HF_API_KEY=your-huggingface-token

# Vector Database Configuration
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=mcp-server

# AWS Configuration
AWS_REGION=us-east-1

# AgentCore Configuration
AGENTCORE_REGION=us-east-1
